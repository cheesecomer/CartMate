<?xml version="1.0" encoding="utf-8"?>
<!-- カートの輪郭とチェックマーク（ブランドカラー）。安全領域（中央の 66dp）いっぱいだと円形のマスクで縁に迫るため、中心を基準に 80% に縮小する。
     左右の車輪の中間（x=58、縮小後 57.2）がアイコンの中心（54）に来るよう、左に 3.2 ずらす -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="-3.2">
    <!-- 持ち手とかご -->
    <path
        android:pathData="M27,34 H34 L37,42 H81 L75,64 H43 L37,42"
        android:strokeColor="#2D6A45"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 台車 -->
    <path
        android:pathData="M43,64 L40,71 H75"
        android:strokeColor="#2D6A45"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 車輪 -->
    <path
        android:fillColor="#2D6A45"
        android:pathData="M40.5,79 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z M66.5,79 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z" />
    <!-- チェックマーク -->
    <path
        android:pathData="M50,53 L56,58.5 L68,47.5"
        android:strokeColor="#2D6A45"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    </group>
</vector>
